# PostgreSQL connection string, for example postgresql://user:password@localhost:5432/devisima
# DATABASE
# PostgreSQL connection string for the target environment.
DATABASE_URL=

# AUTH
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Set to true only behind a trusted deployment proxy such as Vercel.
AUTH_TRUST_HOST=true

# APPLICATION
# Set to the same HTTPS origin as AUTH_URL in staging/production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI ASSISTANT (server-side only; never use a NEXT_PUBLIC_ prefix)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# EMAIL
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_OTP_MAX_ATTEMPTS=5

# PAYMENTS
# Use test credentials until production payment tests are approved.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Leave disabled until payout transfers are tested and explicitly approved.
PAYSTACK_TRANSFERS_ENABLED=false
# Optional; if set, it must match NEXT_PUBLIC_APP_URL/checkout/callback.
PAYSTACK_CALLBACK_URL=

# SECURITY
# Generate a base64-encoded 32-byte key for AES-256-GCM payout account encryption.
PAYOUT_ENCRYPTION_KEY=

# STORAGE
# Local-only storage path. Do not use as production storage on serverless hosts.
PRIVATE_PRODUCT_STORAGE_DIR=
# Private S3-compatible bucket for uploads and paid product assets.
S3_BUCKET=
S3_REGION=
# Optional for AWS S3; required for providers such as R2 or other S3-compatible services.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set true only when the provider requires path-style bucket addressing.
S3_FORCE_PATH_STYLE=false
